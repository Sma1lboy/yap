    "%lld modes, %lld prompts, %lld dictionary entries, %lld shortcuts and %lld custom models or providers (without their API keys). Entries with the same id replace Yap's; the rest of Yap's stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Modi, %lld Prompts, %lld Wörterbucheinträge, %lld Kurzbefehle und %lld eigene Modelle oder Anbieter (ohne API-Schlüssel). Einträge mit derselben ID ersetzen die von Yap; die übrigen bleiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld modes, %lld prompts, %lld entrées de dictionnaire, %lld raccourcis et %lld modèles ou fournisseurs personnalisés (sans leurs clés d’API). Les entrées de même identifiant remplacent celles de Yap ; les autres restent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个模式、%lld 个提示词、%lld 条词典条目、%lld 个快捷键，以及 %lld 个自定义模型或服务商（不含 API key）。id 相同的条目会替换 Yap 里的，其余的 Yap 设置保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個模式、%lld 個提示詞、%lld 條字典項目、%lld 個快速鍵，以及 %lld 個自訂模型或供應商（不含 API key）。id 相同的項目會取代 Yap 裡的，其餘的 Yap 設定保留。"
          }
        }
      }
    },
