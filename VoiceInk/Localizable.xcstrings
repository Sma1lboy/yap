          }
        }
      }
    },
    "Yap could not switch to another microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap konnte nicht zu einem anderen Mikrofon wechseln."
          }
