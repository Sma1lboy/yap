          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 会读取屏幕上的可见内容，以提高转写的准确性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 會讀取螢幕上的可見內容，以提高轉錄的準確性。"
          }
        }
      }
    },
    "Yap recorder dismissed" : {
