    "Both act only on the text Yap pasted last, and only if it's still there unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide wirken nur auf den Text, den Yap zuletzt eingefügt hat, und nur, solange er unverändert an seiner Stelle steht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux n’agissent que sur le dernier texte collé par Yap, et seulement s’il est toujours là, inchangé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
