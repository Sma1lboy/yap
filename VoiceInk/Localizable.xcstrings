          }
        }
      }
    },
    "Yap couldn't access its storage location. Your transcriptions will not be saved between sessions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap konnte nicht auf den Speicherort zugreifen. Deine Transkriptionen werden nicht zwischen Sitzungen gespeichert."
