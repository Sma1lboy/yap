          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien appris ces 7 derniers jours. Quand vous corrigez un mot collé par Yap, la règle ajoutée par l’apprentissage automatique apparaît ici."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
