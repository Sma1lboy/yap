    "A reviewed replacement can contain only one original value." : {
      "comment" : "A reviewed replacement can contain only one original value.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine geprüfte Ersetzung darf nur einen ursprünglichen Wert enthalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
