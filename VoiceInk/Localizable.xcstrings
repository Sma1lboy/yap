    "Yap quit during a meeting. It's being recovered in the background and will be in History." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap wurde während eines Meetings beendet. Es wird im Hintergrund wiederhergestellt und erscheint im Verlauf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap s’est arrêté pendant une réunion. Elle est récupérée en arrière-plan et apparaîtra dans l’historique."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 在会议录制中退出了。正在后台恢复这场会议，完成后会出现在历史记录里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 在會議錄製中退出了。正在背景復原這場會議，完成後會出現在歷史記錄裡。"
          }
        }
      }
    },
    "Yap quit during this meeting, and it couldn't be transcribed afterwards. %@ The audio is saved with this entry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap wurde während dieses Meetings beendet, und es konnte danach nicht transkribiert werden. %@ Die Aufnahme ist bei diesem Eintrag gespeichert."
