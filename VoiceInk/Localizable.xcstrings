    "Modes help you set up Yap for different writing tasks, workflows, and scenarios." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modi helfen dir, Yap für verschiedene Schreibaufgaben, Arbeitsabläufe und Szenarien einzurichten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
