          }
        }
      }
    },
    "Yap modes include Dictation, Enhance, Email, Assistant, Rewrite, Ask, Summarize, and Translate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap-Modi umfassen Diktat, Verbesserung, E-Mail, Assistent, Umschreiben, Fragen, Zusammenfassen und Übersetzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modes Yap incluent Dictée, Améliorer, E-mail, Assistant, Réécriture, Demander, Résumer et Traduire."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 的模式包括听写、润色、邮件、助手、改写、提问、总结和翻译。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 的模式包括聽寫、潤色、郵件、助理、改寫、提問、總結和翻譯。"
          }
        }
      }
    },
    "Yap needs at least one mode to record. Create one to start dictating." : {
      "comment" : "A description of the benefits of creating a mode.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap benötigt mindestens einen Modus zum Aufnehmen. Erstelle einen, um mit dem Diktieren zu beginnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap a besoin d'au moins un mode pour enregistrer. Créez-en un pour commencer à dicter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 至少需要一个模式才能录音。创建一个模式即可开始听写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 至少需要一個模式才能錄音。建立一個模式即可開始聽寫。"
          }
        }
      }
    },
    "Yap pastes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap fügt ein"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap colle"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 粘贴"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 貼上"
          }
        }
      }
    },
    "Yap picks a mode for the app you're in. Press Option 1-9 while recording to switch, and edit modes anytime." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap wählt einen Modus passend zur App, in der du gerade bist. Drücke während der Aufnahme Option 1-9 zum Wechseln und bearbeite Modi jederzeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap choisit un mode selon l’app que vous utilisez. Appuyez sur Option 1-9 pendant l’enregistrement pour changer, et modifiez les modes à tout moment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 会根据你正在使用的 app 自动选择模式。录音时按 Option 1-9 可以切换，模式也可以随时编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 會根據你正在使用的 app 自動選擇模式。錄音時按 Option 1-9 可以切換，模式也可以隨時編輯。"
          }
        }
      }
    },
    "Yap quit while recording. Transcribe it?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap wurde während einer Aufnahme beendet. Aufnahme transkribieren?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap s’est arrêté pendant un enregistrement. Le transcrire ?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 在录音时退出了。要转写这段录音吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 在錄音時退出了。要轉錄這段錄音嗎？"
          }
        }
      }
    },
    "Yap reads visible screen content to improve the accuracy of transcripts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap liest sichtbare Bildschirminhalte, um die Genauigkeit der Transkripte zu verbessern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
