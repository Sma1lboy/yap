    "Press Return while recording to stop and deliver the result. Yap will then paste the result and press the selected key to send it. Choose None to disable this feature." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke während der Aufnahme die Eingabetaste, um die Aufnahme zu beenden und das Ergebnis auszugeben. Yap fügt das Ergebnis anschließend ein und drückt die ausgewählte Taste, um es zu senden. Wähle „Kein“, um diese Funktion zu deaktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Retour pendant l’enregistrement pour l’arrêter et produire le résultat. Yap colle ensuite le résultat et appuie sur la touche choisie pour l’envoyer. Choisissez « Aucun » pour désactiver cette fonction."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音时按 Return 可停止录音并输出结果。Yap 随后会粘贴结果，并按下所选按键将其发送。选择“无”可禁用此功能。"
          }
        }
      }
    },
