    "Sign in to Yap Cloud to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich bei Yap Cloud an, um fortzufahren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à Yap Cloud pour continuer."
          }
        },
