    "Auto Learn checks a paste for up to 60 s, until focus leaves the field. Not an accuracy score: changes after that aren't seen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Learn prüft eine Einfügung bis zu 60 s lang, bis der Fokus das Feld verlässt. Keine Genauigkeitsangabe: Änderungen danach sieht es nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’apprentissage automatique observe un collage jusqu’à 60 s, tant que le champ garde le focus. Ce n’est pas un taux de précision : les modifications faites ensuite ne sont pas vues."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动学习在粘贴后最多看 60 秒，焦点离开输入框就结束。这不是识别准确率：之后的修改看不到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動學習在貼上後最多看 60 秒，焦點離開輸入框就結束。這不是辨識準確率：之後的修改看不到。"
          }
        }
      }
    },
    "Auto Learn is off, so new pastes aren't watched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Learn ist aus, neue Einfügungen werden also nicht beobachtet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’apprentissage automatique est désactivé : les nouveaux collages ne sont pas observés."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动学习已关闭，新的粘贴不会被观察。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動學習已關閉，新的貼上不會被觀察。"
          }
        }
      }
    },
    "Auto Learn is off. Turn it on in Dictionary Settings to learn from the words you correct after Yap pastes." : {
      "comment" : "Empty state of the Recently Learned section when Auto Learn is off.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Learn ist aus. Schalte es in den Wörterbuch-Einstellungen ein, damit Yap aus den Wörtern lernt, die du nach dem Einfügen korrigierst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’apprentissage automatique est désactivé. Activez-le dans les paramètres du dictionnaire pour apprendre des mots que vous corrigez après un collage de Yap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动学习已关闭。在词典设置中打开后，Yap 会从你在粘贴后修改的词里学习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動學習已關閉。在字典設定中開啟後，Yap 會從你在貼上後修改的詞裡學習。"
          }
        }
      }
    },
    "Auto Send" : {
      "localizations" : {
        "de" : {
