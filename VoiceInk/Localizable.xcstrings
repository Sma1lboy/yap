    },
    "The meeting is saved. Its transcript gets Others 1, Others 2… when this is done; you can close this panel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Meeting ist gespeichert. Sein Transkript bekommt „Andere 1“, „Andere 2“…, sobald das fertig ist; du kannst dieses Fenster schließen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réunion est enregistrée. Sa transcription recevra « Autres 1 », « Autres 2 »… une fois terminé ; vous pouvez fermer ce panneau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会议已保存。区分完后，转写会标出对方 1、对方 2…；可以先关掉这个面板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會議已儲存。區分完後，轉錄會標出對方 1、對方 2…；可以先關掉這個面板。"
          }
        }
      }
    },
    "Speakers not told apart" : {
      "localizations" : {
        "de" : {
