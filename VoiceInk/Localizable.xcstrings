    "Dictation won't work until you choose a transcription model. The practice steps will be skipped. You can set it up anytime in Settings or in ~/.config/yap/config.json." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Diktieren funktioniert erst, wenn du ein Transkriptionsmodell auswählst. Die Übungsschritte werden übersprungen. Du kannst es jederzeit in den Einstellungen oder in ~/.config/yap/config.json einrichten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dictée ne fonctionnera pas tant que vous n'aurez pas choisi de modèle de transcription. Les étapes d'entraînement seront ignorées. Vous pouvez le configurer à tout moment dans les Paramètres ou dans ~/.config/yap/config.json."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选好转写模型之前无法听写，练习步骤会跳过。之后随时可以在设置或 ~/.config/yap/config.json 里配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選好轉錄模型之前無法聽寫，練習步驟會略過。之後隨時可以在設定或 ~/.config/yap/config.json 裡設定。"
          }
