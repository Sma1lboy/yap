    },
    "A mode can pass the app name, window title and the text around the cursor to AI enhancement, so names and tone match what you're writing. Turn it on per mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Modus kann App-Namen, Fenstertitel und den Text um den Cursor an die KI-Verbesserung geben, damit Namen und Ton zu dem passen, was du schreibst. Pro Modus einschalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mode peut transmettre le nom de l’app, le titre de la fenêtre et le texte autour du curseur à l’amélioration IA, pour que noms et ton collent à ce que vous écrivez. À activer par mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模式可以把 app 名、窗口标题和光标附近的文字交给 AI 增强，让人名和语气贴合你正在写的内容。按模式单独开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模式可以把 app 名、視窗標題和游標附近的文字交給 AI 增強，讓人名和語氣貼合你正在寫的內容。按模式單獨開啟。"
          }
        }
      }
    },
