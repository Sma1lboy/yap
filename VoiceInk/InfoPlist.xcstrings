    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap benötigt Zugriff auf Ihr Mikrofon, um Audio für die Transkription aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Yap needs access to your microphone to record audio for transcription."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 需要访问麦克风以录制音频用于转录。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap a besoin d'accéder à votre microphone pour enregistrer l'audio à des fins de transcription."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 需要存取麥克風以錄製音訊用於轉錄。"
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap benötigt Zugriff auf die Bildschirmaufnahme, um Kontext von Ihrem Bildschirm für eine höhere Transkriptionsgenauigkeit zu erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Yap needs screen recording access to understand context from your screen for improved transcription accuracy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 需要屏幕录制权限以理解屏幕上的上下文，提高转录准确性。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap a besoin d'un accès à l'enregistrement d'écran pour comprendre le contexte de votre écran afin d'améliorer la précision de la transcription."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 需要螢幕錄製權限以理解螢幕上的上下文，提高轉錄準確性。"
          }
        }
      }
    }
  },
  "version" : "1.0"
