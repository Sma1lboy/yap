    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap muss mit Ihrem Browser interagieren, um die aktuelle Website zu erkennen und website-spezifische Konfigurationen anzuwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Yap needs to interact with your browser to detect the current website for applying website-specific configurations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 需要与浏览器交互以检测当前网站，从而应用针对特定网站的配置。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap doit interagir avec votre navigateur pour détecter le site Web actuel afin d'appliquer des configurations spécifiques au site Web."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap 需要與瀏覽器交互以偵測目前網站，從而應用針對特定網站的設定。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Privacy - Audio Capture Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yap nimmt während einer Meeting-Aufnahme den Ton anderer Apps auf, damit die andere Seite des Calls im Transkript und in den Notizen steht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Yap records the sound from other apps during a meeting recording, so the other side of the call is in the transcript and notes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant l'enregistrement d'une réunion, Yap enregistre le son des autres apps pour que l'autre côté de l'appel figure dans la transcription et les notes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制会议时，Yap 会录下其他 App 的声音，让通话另一方的发言也进入转写和纪要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄製會議時，Yap 會錄下其他 App 的聲音，讓通話另一方的發言也進入轉錄和紀要。"
          }
        }
      }
    },
